{
    "name": "obsidian-sync/backend",
    "description": "Backend REST simples (Slim 4) para sincronizacao de cofres do Obsidian.",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "ObsidianSync\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ObsidianSync\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S 0.0.0.0:8080 -t public",
        "test": "phpunit",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
