# Credenciais de acesso (altere antes de usar em producao!)
SYNC_USER=admin
SYNC_PASSWORD=changeme

# Segredo usado para assinar os tokens JWT (use algo longo e aleatorio)
JWT_SECRET=please-change-this-secret-in-production

# Tempo de vida do token em segundos (86400 = 24h)
JWT_TTL=86400

# Diretorio onde os arquivos do cofre serao salvos
# (padrao: backend/storage). Pode ser um caminho absoluto.
# STORAGE_PATH=/data/obsidian-vault

# Tamanho maximo por arquivo em bytes (0 = ilimitado). Ex.: 26214400 = 25 MB
MAX_FILE_SIZE=0

# Numero de versoes anteriores a manter por arquivo (0 = desativado).
# Quando > 0, sobrescritas e exclusoes guardam uma copia em .versions/
KEEP_VERSIONS=0

# Modo debug: expoe mensagens de erro internas nas respostas JSON (nao use em producao!)
# APP_DEBUG=false

# CORS: quando definido, adiciona Access-Control-Allow-Origin nessa origem.
# Deixe vazio (padrao) para desabilitar CORS — o dashboard usa proxy Vite em dev.
# CORS_ALLOW_ORIGIN=https://meu-dashboard.exemplo.com

# Usuarios com escopo por cofre (multi-usuario). Caminho de um JSON no formato:
#   { "admin": {"password":"...","vaults":"*"},
#     "alice": {"password":"...","vaults":["pessoal","trabalho"]} }
# Sem USERS_FILE, usa-se SYNC_USER/SYNC_PASSWORD com acesso a todos os cofres ("*").
# USERS_FILE=/etc/obsidian-sync/users.json
