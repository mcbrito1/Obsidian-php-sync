{
    "name": "obsidian-php-sync-dashboard",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Dashboard web (React + Vite) para inspecionar cofres e mesclar arquivos (estilo Meld).",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
