    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@testing-library/jest-dom": "^6.4.6",
        "@testing-library/react": "^14.3.1",
        "@testing-library/user-event": "^14.5.2",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "eslint": "^9.39.4",
        "jsdom": "^24.1.0",
        "typescript": "^5.4.5",
        "typescript-eslint": "^8.62.0",
        "vite": "^5.3.1",
