{
    "name": "obsidian-php-sync",
    "version": "1.0.0",
    "description": "Plugin do Obsidian para sincronizar o cofre com um backend REST em PHP (Slim 4).",
    "main": "main.js",
    "type": "module",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "tsc --noEmit --skipLibCheck && eslint .",
        "typecheck": "tsc --noEmit --skipLibCheck"
    },
    "keywords": [
        "obsidian",
        "sync",
        "php"
    ],
    "license": "Apache-2.0",
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/node": "^20.11.0",
        "esbuild": "^0.20.0",
        "eslint": "^9.39.4",
        "obsidian": "^1.4.11",
        "typescript": "^5.4.0",
        "typescript-eslint": "^8.62.0",
        "vitest": "^1.6.0"
    }
}
