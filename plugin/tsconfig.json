{
    "compilerOptions": {
        "baseUrl": ".",
        "module": "ESNext",
        "target": "ES2020",
        "moduleResolution": "node",
        "allowJs": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "strict": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "lib": [
            "DOM",
            "ES2020"
        ],
        "types": [
            "node"
        ]
    },
    "include": [
        "main.ts",
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "tests"
    ]
}
